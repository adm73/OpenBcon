# Public host. Create an A/AAAA record for this host before starting Caddy.
DOMAIN=your-domain.example

# Build-time license visibility. Keep false for the AGPL community edition.
# Set true only for a paid commercial deployment, then rebuild the API image.
VITE_COMMERCIAL_LICENSED=false
# deploy/deploy.sh fills this from the current Git commit automatically.
VITE_APP_COMMIT=unknown

# Database credentials are generated by the deployment wizard.
POSTGRES_DB=bconomics
POSTGRES_USER=replace_with_generated_postgres_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
MONGODB_DATABASE=bconomics
MONGODB_ROOT_USERNAME=replace_with_generated_mongo_user
MONGODB_ROOT_PASSWORD=replace_with_a_long_mongo_password

# The primary database is the shared platform catalog database. Create the
# separate Test and Live databases before first production startup.
DATABASE_URL_SHARED=postgresql://bconomics:bconomics@postgres:5432/bconomics
DATABASE_URL_TEST=postgresql://bconomics:bconomics@postgres:5432/bconomics_test
DATABASE_URL_LIVE=postgresql://bconomics:bconomics@postgres:5432/bconomics_live
MONGODB_DATABASE_SHARED=bconomics
MONGODB_DATABASE_TEST=bconomics_test
MONGODB_DATABASE_LIVE=bconomics_live

# Node API
# Server-authoritative runtime mode. Change this value and restart the stack.
OPENBCON_ENVIRONMENT_MODE=test
APP_STATE_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32
AUTH_SESSION_TTL_DAYS=30
PUBLIC_APP_URL=https://your-domain.example
# Test Mode does not require SMTP. Console delivery logs verification and
# password-reset previews on the server. Configure SMTP before Live Mode.
EMAIL_PROVIDER=console
EMAIL_FROM=OpenBcon <no-reply@your-domain.example>
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@your-domain.example
# SMTP_PASSWORD=replace_with_smtp_password
# Replace your-domain.example and register this exact URL in Google Cloud Console
# if Google sign-in is enabled.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Python/LangGraph API
OPENBCON_OPENAI_API_KEY=replace_with_a_server_side_openai_key
OPENBCON_OPENAI_MODEL=gpt-5
OLLAMA_MODEL=smollm2:135m
OPENBCON_OLLAMA_BASE_URL=http://ollama:11434
OPENBCON_OLLAMA_MODEL=smollm2:135m
# Test Mode always uses the mock gateway. Live Mode uses the provider key.
OPENBCON_DB_DSN_TEST=postgresql://bconomics:bconomics@postgres:5432/bconomics_test
OPENBCON_DB_DSN_SHARED=postgresql://bconomics:bconomics@postgres:5432/bconomics
OPENBCON_DB_DSN_LIVE=postgresql://bconomics:bconomics@postgres:5432/bconomics_live
OPENBCON_MONGODB_DATABASE_SHARED=bconomics
OPENBCON_MONGODB_DATABASE_TEST=bconomics_test
OPENBCON_MONGODB_DATABASE_LIVE=bconomics_live
OPENBCON_USE_MOCK_LLM=false
OPENBCON_ALLOWED_AI_ENDPOINT_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,openrouter.ai
OPENBCON_ALLOW_PRIVATE_AI_ENDPOINTS=false
