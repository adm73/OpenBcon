FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_BUSINESS_PLAN_API_URL=/ai-api
ENV VITE_BUSINESS_PLAN_API_URL=${VITE_BUSINESS_PLAN_API_URL}

ARG VITE_PUBLIC_SITE_URL=http://localhost:5173
ENV VITE_PUBLIC_SITE_URL=${VITE_PUBLIC_SITE_URL}

ARG VITE_DASHBOARD_APP_URL=http://localhost:5173
ENV VITE_DASHBOARD_APP_URL=${VITE_DASHBOARD_APP_URL}

ARG VITE_COMMERCIAL_LICENSED=false
ENV VITE_COMMERCIAL_LICENSED=${VITE_COMMERCIAL_LICENSED}

ARG VITE_APP_COMMIT=unknown
ENV VITE_APP_COMMIT=${VITE_APP_COMMIT}

ARG VITE_APP_VERSION=unreleased
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

RUN npm run build

FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server

EXPOSE 8787

CMD ["npm", "run", "start"]
